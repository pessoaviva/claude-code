# PostgreSQL connection
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack

# HTTP server
PORT=4000

# Quote integration (optional). If unset/unreachable the system falls back to
# MANUAL quote entry and keeps working normally.
# Example provider: brapi.dev (Brazilian stocks). Token optional for some tickers.
QUOTE_PROVIDER_URL=https://brapi.dev/api/quote
QUOTE_PROVIDER_TOKEN=
QUOTE_TIMEOUT_MS=4000
