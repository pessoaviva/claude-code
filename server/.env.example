# PostgreSQL connection
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack

# HTTP server
PORT=4000

# --- Quote providers (fallback chain, tried in order) ----------------------
# The system works fully WITHOUT any of these via MANUAL quote entry.
# Providers without a required key are automatically skipped.

# 1) Brapi (Brazilian stocks) — token optional for some tickers
BRAPI_URL=https://brapi.dev/api/quote
BRAPI_TOKEN=

# 2) Yahoo Finance (no key; B3 tickers get a .SA suffix automatically)
YAHOO_URL=https://query1.finance.yahoo.com/v8/finance/chart

# 3) Alpha Vantage (requires free API key)
ALPHAVANTAGE_URL=https://www.alphavantage.co/query
ALPHAVANTAGE_KEY=

# 4) Finnhub (requires free API key)
FINNHUB_URL=https://finnhub.io/api/v1/quote
FINNHUB_KEY=

# Shared fetch timeout (ms)
QUOTE_TIMEOUT_MS=4000

# --- Reliability A/B/C thresholds (minutes) --------------------------------
# A: idade < FRESH ; B: FRESH..STALE ; C: > STALE / inválida / ausente
RELIABILITY_FRESH_MIN=15
RELIABILITY_STALE_MIN=60

# Legacy single-provider knobs (still honored as Brapi defaults)
QUOTE_PROVIDER_URL=https://brapi.dev/api/quote
QUOTE_PROVIDER_TOKEN=
