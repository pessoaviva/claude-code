# Back-end opcional (Supabase). Sem estas variáveis, o app roda 100% no
# navegador (localStorage + criptografia). Com as duas preenchidas, passa a
# usar login real (Supabase Auth) e dados na nuvem.
#
# Na Vercel: Project → Settings → Environment Variables → adicione as duas → Redeploy.
# Local: copie este arquivo para ".env" e preencha.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
